int suum(const char *filename, int size)
{
    int sum = 0;
    int buffer;
 FILE*   f = fopen(filename, "r");
    for (int i = 0; i < size; i++)
    {
        fscanf(f, "%d", &buffer);
        sum += buffer;

    }
    fclose(f);
    return sum;
}

