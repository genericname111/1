#include <stdio.h>

int in(const char* filename, int size)
{
    int buffer;
    FILE* f = fopen(filename, "w");
    for (int i = 0; i < size; i++)
    {
        scanf("%d", &buffer);
        fprintf(f, "%d ", buffer);
    }
    fclose(f);
    return buffer;
}

void out(const char* filename, int size)
{
    int buffer;
 FILE*   f = fopen(filename, "r");
    for (int i = 0; i < size; i++)
    {
        fscanf(f, "%d ", &buffer);
        printf("%d ", buffer);

    }
    fclose(f);
}


